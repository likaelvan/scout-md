# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Check available models with:  python -m scripts.check_llm
LLM_MODEL=llama-3.3-70b-versatile

# Live database location (default: C:\Users\<you>\doctor_data\leads.db, outside OneDrive)
# DATA_DIR=

# Outreach safety: while true, every email goes to TEST_INBOX instead of doctors.
TEST_MODE=true
TEST_INBOX=

# Web search (Serper, Google results) - used to find clinic pages and emails
SERPER_API_KEY=
